summarise(
.by = c(TIME_PERIOD,REF_AREA,REF_AREA_LABEL)
, health_spend = sum(OBS_VALUE,na.rm = T)
) %>% arrange(desc(REF_AREA_LABEL))
#& COMP_BREAKDOWN_1_LABEL =="Sector: General government"
) %>%
SAL %>% filter(TIME_PERIOD>= 2019 & OBS_VALUE!= 0 & UNIT_MEASURE_LABEL == "Domestic currency"
